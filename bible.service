# systemd service for Bible App
# დააკოპირეთ: /etc/systemd/system/bible.service
# გააქტიურება: sudo systemctl daemon-reload
#              sudo systemctl enable bible
#              sudo systemctl start bible
# სტატუსი: sudo systemctl status bible
# ლოგები: journalctl -u bible -f

[Unit]
Description=Bible App (Georgian Bible - Flask/Gunicorn)
After=network.target

[Service]
Type=notify
User=www-data
Group=www-data
WorkingDirectory=/path/to/bible_app
Environment="PYTHONUNBUFFERED=1"
Environment="PYTHONPATH=/path/to/bible_app"
# Gunicorn-ის გაშვება
ExecStart=/usr/bin/gunicorn -c gunicorn.conf.py server:app
ExecReload=/bin/kill -s HUP $MAINPID
Restart=on-failure
RestartSec=5
TimeoutStartSec=180
TimeoutStopSec=30

# უსაფრთხოება
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/path/to/bible_app/data /tmp
ProtectHome=true

[Install]
WantedBy=multi-user.target
